# Copy to .env and replace every value. Never commit .env.
APP_ENV=development
POSTGRES_PASSWORD=change-me-owner-password
APP_DB_PASSWORD=change-me-app-password
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
PII_HASH_SECRET=
# Must be true behind HTTPS (enforced when APP_ENV=production).
COOKIE_SECURE=false
SEED_DEMO_DATA=true

# Optional: AI weekly summary (model claude-haiku-4-5).
ANTHROPIC_API_KEY=

# Optional: Shopee Open Platform integration (https://open.shopee.com).
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
# Test: https://partner.test-stable.shopeemobile.com  Production: https://partner.shopeemobile.com
SHOPEE_API_HOST=https://partner.test-stable.shopeemobile.com
# Must match the redirect URL registered in the Shopee app console.
SHOPEE_REDIRECT_URL=http://localhost:8080/api/shopee/callback
SHOPEE_SYNC_INTERVAL_MINUTES=30
# Encrypts Shopee tokens at rest. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
